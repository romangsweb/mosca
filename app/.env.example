# Cuenta en la nube (Supabase). Ambas son públicas por diseño; la seguridad la dan las políticas RLS.
# Sin estas variables la app funciona 100 % local.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Pagos con Paddle (también públicas: el token de cliente solo abre el checkout).
# Sin ellas, el botón dice «Pago disponible pronto». En sandbox usa la tarjeta 4242 4242 4242 4242.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_tu-token-de-cliente
VITE_PADDLE_PRICE_MES=pri_precio-mensual
VITE_PADDLE_PRICE_ANO=pri_precio-anual
